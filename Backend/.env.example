# Variables de entorno esperadas por ambos backends (login_api y aula_api).
# Para desarrollo local en Windows, usa Backend/local.env.ps1 (ver local.env.ps1.example)
# en lugar de este archivo. Este .env.example sirve como referencia para configurar
# las variables de entorno del servicio en la nube (Render, Railway, etc.).

# Compartida por ambas APIs: deben tener el MISMO valor para que el token de
# login (firmado en login_api) se pueda validar en aula_api.
AULA_SHARED_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio-en-la-nube.com
CORS_ALLOWED_ORIGINS=

# --- API aula (academico) ---
AULA_POSTGRES_DB=aula_virtual_academica
AULA_POSTGRES_USER=postgres
AULA_POSTGRES_PASSWORD=
AULA_POSTGRES_HOST=
AULA_POSTGRES_PORT=5432

# --- API login (cuentas) ---
LOGIN_POSTGRES_DB=login_db
LOGIN_POSTGRES_USER=postgres
LOGIN_POSTGRES_PASSWORD=
LOGIN_POSTGRES_HOST=
LOGIN_POSTGRES_PORT=5432
