# Copia este archivo a "local.env.ps1" (sin ".example") en la misma carpeta y
# pon ahi tus valores reales. local.env.ps1 esta en .gitignore, asi que nunca se
# sube al repo ni al ZIP de entrega.
#
# run_aula.ps1 y run_login.ps1 cargan este archivo automaticamente si existe.

$env:AULA_SHARED_SECRET_KEY   = 'cambia-esto-por-una-clave-larga-y-secreta'

$env:AULA_POSTGRES_PASSWORD   = 'tu-password-de-postgres-para-aula_virtual_academica'
$env:LOGIN_POSTGRES_PASSWORD  = 'tu-password-de-postgres-para-login_db'

# Solo para desarrollo local. En la nube, DJANGO_DEBUG debe quedar en False
# (o simplemente no definirse) y DJANGO_ALLOWED_HOSTS debe apuntar al dominio real.
$env:DJANGO_DEBUG = 'True'
