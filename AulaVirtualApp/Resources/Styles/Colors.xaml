<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta institucional (verde UMES + neutros calidos) -->
    <Color x:Key="Primary">#0A402C</Color>
    <Color x:Key="PrimaryDark">#062D1E</Color>
    <Color x:Key="PrimaryMid">#58A66B</Color>
    <Color x:Key="PrimarySoft">#7CA67F</Color>
    <!-- Tinte verde muy claro para tarjetas destacadas (se distingue del fondo beige) -->
    <Color x:Key="PrimaryLight">#E7EFE8</Color>
    <Color x:Key="Secondary">#58A66B</Color>

    <Color x:Key="Background">#D9D0C1</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="BorderSoft">#C4B9A8</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#F2F2F2</Color>
    <Color x:Key="Gray300">#D9D0C1</Color>
    <Color x:Key="Gray600">#6B7A70</Color>
    <Color x:Key="ErrorRed">#C62828</Color>
    <Color x:Key="WarningAmber">#8A6D1F</Color>

</ResourceDictionary>
