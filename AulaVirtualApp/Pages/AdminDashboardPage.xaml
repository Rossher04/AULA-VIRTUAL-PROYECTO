<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AulaVirtualApp.Pages.AdminDashboardPage"
             Title="Panel de Administrador">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="640" HorizontalOptions="Center">

            <Frame Style="{StaticResource CardFrame}" BackgroundColor="{StaticResource PrimaryLight}" Padding="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Panel de Administrador" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <Label x:Name="UserLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Estructura academica" Style="{StaticResource CardTitle}" />
                    <Button Text="Facultades" Clicked="OnFacultadesClicked" />
                    <Button Text="Carreras" Clicked="OnCarrerasClicked" />
                    <Button Text="Semestres" Clicked="OnSemestresClicked" />
                    <Button Text="Asignar semestre a carrera" Clicked="OnCarreraSemestresClicked" />
                    <Button Text="Cursos" Clicked="OnCursosClicked" />
                    <Button Text="Asignar curso a semestre por carrera" Clicked="OnPensumClicked" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Personas" Style="{StaticResource CardTitle}" />
                    <Button Text="Catedraticos (crear con usuario)" Clicked="OnDocentesClicked" />
                    <Button Text="Alumnos (crear con usuario)" Clicked="OnEstudiantesClicked" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Asignacion de docencia" Style="{StaticResource CardTitle}" />
                    <Button Text="Asignar catedratico a curso" Clicked="OnSeccionesClicked" />
                    <Button Text="Asignar alumno a curso" Clicked="OnEstudianteSeccionesClicked" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Datos de apoyo" Style="{StaticResource CardTitle}" />
                    <Label Text="Requeridos por la asignacion de docencia (ciclo, aula, horario)."
                           Style="{StaticResource MutedLabel}" Margin="0,0,0,4" />
                    <Button Text="Ciclos academicos" Clicked="OnCiclosClicked" Style="{StaticResource SecondaryButton}" />
                    <Button Text="Aulas fisicas" Clicked="OnAulasClicked" Style="{StaticResource SecondaryButton}" />
                    <Button Text="Modulos horarios" Clicked="OnModulosClicked" Style="{StaticResource SecondaryButton}" />
                    <Button Text="Horarios" Clicked="OnHorariosClicked" Style="{StaticResource SecondaryButton}" />
                    <Button Text="Instituciones" Clicked="OnInstitucionesClicked" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Cerrar sesion" Clicked="OnLogoutClicked" Style="{StaticResource DangerButton}" Margin="0,4,0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
